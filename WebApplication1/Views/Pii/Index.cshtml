@{
    ViewData["Title"] = "PII Detection";
}

<h2>PII (Особиста Ідентифікаційна Інформація)</h2>

<form method="post">
    <label>Введіть текст:</label><br />
    <textarea name="inputText" rows="5" cols="60"></textarea><br />
    <input type="submit" value="Розпізнати PII" />
</form>

@if (ViewBag.OriginalText != null)
{
    <h3>Оригінальний текст:</h3>
    <p>@ViewBag.OriginalText</p>

    <h3>Текст з прихованою PII:</h3>
    <p>@ViewBag.RedactedText</p>
}
