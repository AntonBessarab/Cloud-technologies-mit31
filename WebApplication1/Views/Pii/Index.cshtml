@{
    ViewData["Title"] = "PII Detection";
}

<h2>PII (Personally Identifiable Information)</h2>

<form method="post">
    <label>Enter text:</label><br />
    <textarea name="inputText" rows="5" cols="60"></textarea><br />
    <input type="submit" value="Recognize PII" />
</form>

@if (ViewBag.OriginalText != null)
{
    <h3>Original text:</h3>
    <p>@ViewBag.OriginalText</p>

    <h3>Text with hidden PII:</h3>
    <p>@ViewBag.RedactedText</p>
}
