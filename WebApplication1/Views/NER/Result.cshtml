@model List<WebApplication1.Models.NamedEntityModel>

<h2>Named Entities</h2>

@if (Model.Count == 0)
{
    <p>No entities recognized.</p>
}
else
{
    <table border="1">
        <tr>
            <th>Text</th>
            <th>Category</th>
            <th>SubCategory</th>
            <th>Confidence</th>
        </tr>
        @foreach (var entity in Model)
        {
            <tr>
                <td>@entity.Text</td>
                <td>@entity.Category</td>
                <td>@entity.SubCategory</td>
                <td>@entity.ConfidenceScore</td>
            </tr>
        }
    </table>
}
