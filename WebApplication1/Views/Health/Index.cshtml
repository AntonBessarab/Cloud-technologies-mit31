@{
    ViewData["Title"] = "Text Analytics for Health";
}

<h2>Medical information (Text Analytics for Health)</h2>

<form method="post">
    <label>Enter text:</label><br />
    <textarea name="inputText" rows="5" cols="60"></textarea><br />
    <input type="submit" value="Analize" />
</form>

@if (ViewBag.Entities != null)
{
    <h3>Recognized Healthcare Entities</h3>
    <table border="1">
        <tr>
            <th>Text</th>
            <th>Category</th>
            <th>Confidence</th>
        </tr>
        @foreach (var entity in ViewBag.Entities)
        {
            <tr>
                <td>@entity.Text</td>
                <td>@entity.Category</td>
                <td>@entity.ConfidenceScore</td>
            </tr>
        }
    </table>
}
